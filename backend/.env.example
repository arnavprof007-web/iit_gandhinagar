# ==============================================================================
# GreenPulse Mission LiFE — Backend Environment Configuration Example
# Copy this file to .env and provide your deployment-specific configuration.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenpulse_db?schema=public

# Authentication & Security
# Generate a strong 64-character secret for production: openssl rand -base64 48
SESSION_SECRET=replace_with_a_secure_session_secret_at_least_32_characters
SESSION_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_FAILED_ATTEMPTS=5

# Email Delivery (Supported: smtp | resend | dev_log)
EMAIL_PROVIDER=dev_log
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username_here
EMAIL_PASSWORD=your_smtp_password_here
EMAIL_FROM="Mission LiFE GreenPulse" <no-reply@greenpulse.gov.in>

# Initial Platform Administrator Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@greenpulse.gov.in
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# Private Upload Storage & Evidence Verification
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Optical Document & Receipt Recognition (OCR/ICR)
# Options: mock | local_tesseract | cloud_vision
OCR_PROVIDER=mock

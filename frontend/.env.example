# GreenPulse Frontend Configuration
# This is a frontend-only platform phase for HackCult '26 Mission LiFE Track.
# All data is mocked through src/services and persisted locally via browser state.

VITE_APP_NAME="GreenPulse"
VITE_APP_VERSION="1.0.0"
# Set to false once real backend API is integrated
VITE_ENABLE_MOCK_SERVICES=true

# Real Express Backend API endpoint:
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Weather insights provider configuration:
# VITE_WEATHER_API_URL=https://api.weather.mock

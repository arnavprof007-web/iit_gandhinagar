{
  "name": "greenpulse-monorepo",
  "version": "1.0.0",
  "description": "GreenPulse — Mission LiFE Sustainability Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "db:start": "npm --prefix backend run db:start",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:status": "npm --prefix backend run db:status",
    "start": "node scripts/dev.js",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "build": "npm --prefix frontend run build"
  }
}
